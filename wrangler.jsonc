// Serveur temps réel et fichiers statiques du jeu.
// Adresse du jeu : https://cendre-rts.<compte>.workers.dev/game/
{
  "name": "cendre-rts",
  "main": "server/worker.js",
  "durable_objects": { "bindings": [{ "name": "MATCH", "class_name": "Match" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Match"] }],
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/ws"],
    "html_handling": "auto-trailing-slash",
  },
}
